+rpm_plan = BuildPlan[core.TargetInventory](state, core.BuildOptions(), [("demo", None, None)], [], [], False, None)
+deb_plan = BuildPlan[apt_core.AptTargetInventory](state, core.BuildOptions(), [], [], [], False, None)
