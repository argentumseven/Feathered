-                    _restore(ExactPackageRecord, row)
-                    for row in payload.get("exact_packages") or ())
-            built[name] = _restore(section_cls, payload)
-        return cls(**built)
+        return _restore(cls, data)
 
     @classmethod
     def from_json(cls, text: str) -> "BuildSpec":
