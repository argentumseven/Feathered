# Byte-compiled caches are interpreter-specific and can mask import problems.
__pycache__/
*.py[cod]
*.egg-info/

# Generated gate evidence. release_test_runner.py and CI write here; results are
# published as workflow artifacts, not committed alongside the source.
validation/

# Build and release output. Generated integrity manifests are derived from the
# final tree and are not committed, which keeps branch merges free of hash-only conflicts.
SOURCE-SHA256.json

# RELEASE-MANIFEST.json and SHA256SUMS.txt are generated into dist/ by the signed build.
build/
dist/
*.spec
build-exe.log

# Virtual environments used by the build and CI gates.
.venv/
venv/
.release-venv/

# Test and coverage state.
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# Editor and OS noise. Working copies of source files can also create
# duplicate module/test basenames and should stay outside the repository.
*.orig
*.rej
*.bak
*~
.idea/
.vscode/
.DS_Store
Thumbs.db

# static analysis caches
.mypy_cache/
.ruff_cache/

# Local credentials and signing material. Public trust fixtures should use
# explicit, narrowly scoped exceptions if the project ever needs them.
.env
.env.*
*.pfx
*.p12
*.pem
*.key
