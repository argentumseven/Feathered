# Normalize text source to LF on every platform so generated checksums and
# release artifacts describe the same bytes on Linux and Windows. text=auto
# leaves genuinely binary files alone.
* text=auto eol=lf

# Hash-locked build inputs and target-side shell scripts keep their committed
# bytes unchanged regardless of platform checkout defaults.
requirements-build.lock -text
*.sh -text

# Windows scripts keep exactly the bytes that were committed. run_gui.bat is
# stored with CRLF, and normalizing it would change its hash on every platform
# rather than only on Windows -- trading a Windows-only manifest failure for a
# universal one. cmd.exe is also the one interpreter here that can misparse an
# LF-only batch file, so leave these alone entirely.
*.bat -text
*.ps1 -text
